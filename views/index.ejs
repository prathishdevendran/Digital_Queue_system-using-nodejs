<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CareFlow - Hospital Digital Queue System</title>
  <meta name="description" content="A premium Samsung One UI 8.5 inspired digital health patient queue manager with light/dark theme support and circular queue tracking.">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="container">
    <!-- Top Action Panel -->
    <div class="top-bar">
      <!-- Dark Mode Switch -->
      <div class="theme-switch-container">
        <label class="theme-switch" for="theme-toggle-input">
          <input type="checkbox" id="theme-toggle-input" aria-label="Toggle dark mode">
          <span class="slider"></span>
        </label>
        <span id="theme-label" style="font-family: var(--font-title); font-size: 13px; font-weight: 600; color: var(--text-secondary);">Light Mode</span>
      </div>

      <!-- History Link -->
      <a href="/history" id="history-nav-btn" class="pill-btn">
        <span>View History</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </a>
    </div>

    <!-- One UI Large breathing Header -->
    <header class="oneui-header">
      <h1 id="main-header-title">CareFlow</h1>
      <p id="main-header-subtitle">Digital Patient Priority Queue Management</p>
    </header>

    <!-- Main Grid Layout -->
    <main class="dashboard-grid">
      <!-- Left side: Add Patient Panel -->
      <section class="oneui-card card-form">
        <div class="card-title-area">
          <h2>Register Patient</h2>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="17" y1="11" x2="23" y2="11"/></svg>
        </div>

        <form action="/add" method="POST" id="add-patient-form">
          <div class="form-group">
            <input type="text" id="patient-name-input" name="name" class="oneui-input" placeholder="Patient Full Name" required autocomplete="off">
          </div>

          <div class="form-group">
            <input type="number" id="patient-age-input" name="age" class="oneui-input" placeholder="Age" min="0" max="150" required>
          </div>

          <div class="form-group">
            <input type="tel" id="patient-phone-input" name="phone" class="oneui-input" placeholder="Phone Number (e.g. 9876543210)" required>
          </div>

          <div class="form-group">
            <select id="patient-priority-select" name="priority" class="oneui-input oneui-select" required>
              <option value="" disabled selected hidden>Select Priority Level</option>
              <option value="high">High Priority (Emergency)</option>
              <option value="medium">Medium Priority (Urgent)</option>
              <option value="low">Low Priority (Routine)</option>
            </select>
          </div>

          <button type="submit" id="add-patient-btn" class="oneui-btn-submit">
            <span>Add to Queue</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </form>
      </section>

      <!-- Right side: Queues display -->
      <section class="queues-container">
        <!-- High Priority Queue -->
        <article class="oneui-card card-high">
          <div class="card-title-area">
            <h2>High Priority</h2>
            <!-- Capacity Dot indicators (limit 5) -->
            <div class="capacity-dots" title="Queue utilization">
              <% for (let i = 0; i < 5; i++) { %>
                <div class="capacity-dot <%= i < high.length ? 'active' : '' %>"></div>
              <% } %>
              <span class="capacity-text"><%= high.length %>/5</span>
            </div>
          </div>

          <ul class="patient-list" id="high-queue-list">
            <% if (high.length === 0) { %>
              <li class="empty-state">
                <span class="empty-state-icon">🚑</span>
                <p>No critical patients</p>
              </li>
            <% } else { %>
              <% high.forEach(p => { %>
                <li class="patient-item">
                  <div class="patient-info">
                    <span class="patient-name"><%= p.name %></span>
                    <span class="patient-details">ID: <%= p.id %> • Age: <%= p.age %></span>
                  </div>
                  <span class="patient-badge">High</span>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </article>

        <!-- Medium Priority Queue -->
        <article class="oneui-card card-medium">
          <div class="card-title-area">
            <h2>Medium Priority</h2>
            <div class="capacity-dots" title="Queue utilization">
              <% for (let i = 0; i < 5; i++) { %>
                <div class="capacity-dot <%= i < medium.length ? 'active' : '' %>"></div>
              <% } %>
              <span class="capacity-text"><%= medium.length %>/5</span>
            </div>
          </div>

          <ul class="patient-list" id="medium-queue-list">
            <% if (medium.length === 0) { %>
              <li class="empty-state">
                <span class="empty-state-icon">🕒</span>
                <p>No urgent patients</p>
              </li>
            <% } else { %>
              <% medium.forEach(p => { %>
                <li class="patient-item">
                  <div class="patient-info">
                    <span class="patient-name"><%= p.name %></span>
                    <span class="patient-details">ID: <%= p.id %> • Age: <%= p.age %></span>
                  </div>
                  <span class="patient-badge">Medium</span>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </article>

        <!-- Low Priority Queue -->
        <article class="oneui-card card-low">
          <div class="card-title-area">
            <h2>Low Priority</h2>
            <div class="capacity-dots" title="Queue utilization">
              <% for (let i = 0; i < 5; i++) { %>
                <div class="capacity-dot <%= i < low.length ? 'active' : '' %>"></div>
              <% } %>
              <span class="capacity-text"><%= low.length %>/5</span>
            </div>
          </div>

          <ul class="patient-list" id="low-queue-list">
            <% if (low.length === 0) { %>
              <li class="empty-state">
                <span class="empty-state-icon">🩺</span>
                <p>No routine patients</p>
              </li>
            <% } else { %>
              <% low.forEach(p => { %>
                <li class="patient-item">
                  <div class="patient-info">
                    <span class="patient-name"><%= p.name %></span>
                    <span class="patient-details">ID: <%= p.id %> • Age: <%= p.age %></span>
                  </div>
                  <span class="patient-badge">Low</span>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </article>
      </section>
    </main>
  </div>

  <!-- Floating Bottom Panel for serving the next patient -->
  <form action="/serve" method="POST" id="serve-patient-form">
    <div class="oneui-floating-action-bar" id="floating-action-panel">
      <div class="floating-status-info">
        <span class="floating-status-label">Next Up</span>
        <span class="floating-status-value">
          <% if (!allEmpty) { %>
            <% if (high.length > 0) { %>
              <span class="status-indicator-dot active-high"></span> <%= high[0].name %> (High)
            <% } else if (medium.length > 0) { %>
              <span class="status-indicator-dot active-med"></span> <%= medium[0].name %> (Med)
            <% } else { %>
              <span class="status-indicator-dot active-low"></span> <%= low[0].name %> (Low)
            <% } %>
          <% } else { %>
            <span class="status-indicator-dot"></span> Empty Queue
          <% } %>
        </span>
      </div>

      <button type="submit" id="serve-patient-btn" class="btn-serve-floating" <% if (allEmpty) { %> disabled <% } %>>
        <span>Serve Patient</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
  </form>

  <!-- Theme switching script -->
  <script>
    const toggleInput = document.getElementById('theme-toggle-input');
    const themeLabel = document.getElementById('theme-label');
    const htmlElement = document.documentElement;

    // Load saved preference
    const savedTheme = localStorage.getItem('theme') || 'light';
    htmlElement.setAttribute('data-theme', savedTheme);
    toggleInput.checked = (savedTheme === 'dark');
    themeLabel.textContent = savedTheme === 'dark' ? 'Dark Mode' : 'Light Mode';

    // Switch handler
    toggleInput.addEventListener('change', () => {
      if (toggleInput.checked) {
        htmlElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        themeLabel.textContent = 'Dark Mode';
      } else {
        htmlElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
        themeLabel.textContent = 'Light Mode';
      }
    });

    // Subtly hide/compress floating action bar on scroll down to match One UI 8 "Ambient" guideline
    let lastScrollTop = 0;
    const floatingBar = document.getElementById('floating-action-panel');
    window.addEventListener('scroll', () => {
      let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      if (scrollTop > lastScrollTop && scrollTop > 100) {
        // Scrolling down - translate bar slightly out of screen/fade
        floatingBar.style.transform = 'translateX(-50%) translateY(90px)';
        floatingBar.style.opacity = '0.3';
      } else {
        // Scrolling up
        floatingBar.style.transform = 'translateX(-50%) translateY(0)';
        floatingBar.style.opacity = '1';
      }
      lastScrollTop = scrollTop;
    });

    // Make floating action bar interactive on hover even when minimized
    floatingBar.addEventListener('mouseenter', () => {
      floatingBar.style.transform = 'translateX(-50%) translateY(0)';
      floatingBar.style.opacity = '1';
    });
  </script>
</body>
</html>

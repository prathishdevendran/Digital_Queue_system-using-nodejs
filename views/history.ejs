<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Served Patients History - CareFlow</title>
  <meta name="description" content="A list of served patients in the CareFlow Digital Queue System.">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="container">
    <!-- Top Action Panel -->
    <div class="top-bar">
      <!-- Dark Mode Switch -->
      <div class="theme-switch-container">
        <label class="theme-switch" for="theme-toggle-input">
          <input type="checkbox" id="theme-toggle-input" aria-label="Toggle dark mode">
          <span class="slider"></span>
        </label>
        <span id="theme-label" style="font-family: var(--font-title); font-size: 13px; font-weight: 600; color: var(--text-secondary);">Light Mode</span>
      </div>

      <!-- Back Link -->
      <a href="/" id="back-nav-btn" class="pill-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <span>Back to Queue</span>
      </a>
    </div>

    <!-- One UI Large Header -->
    <header class="oneui-header">
      <h1 id="history-header-title">Served History</h1>
      <p id="history-header-subtitle">Record of recently attended patients</p>
    </header>

    <!-- Main Content Area -->
    <main class="history-layout">
      <div class="oneui-card" style="padding: 24px;">
        <div class="card-title-area" style="margin-bottom: 20px;">
          <h2>Patient Log</h2>
          <span style="font-size: 13px; color: var(--text-secondary); font-weight: 600;"><%= history.length %> Patients Served</span>
        </div>

        <ul class="patient-list" style="gap: 16px;">
          <% if (history.length === 0) { %>
            <li class="empty-state" style="padding: 60px 20px;">
              <span class="empty-state-icon">📁</span>
              <p>No history records found.</p>
              <span style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">Patients will appear here once served.</span>
            </li>
          <% } else { %>
            <% history.forEach((p, idx) => { %>
              <li class="history-card-item">
                <div class="history-patient-main">
                  <!-- Circular avatar with initial -->
                  <div class="history-avatar" id="avatar-<%= p.id %>">
                    <%= p.name.charAt(0).toUpperCase() %>
                  </div>
                  <div class="history-details-grid">
                    <span class="patient-name"><%= p.name %></span>
                    <span class="history-phone">Phone: <%= p.phone %></span>
                  </div>
                </div>

                <div class="history-meta">
                  <span class="patient-badge" style="background-color: var(--color-primary-bg); color: var(--color-primary); font-size: 11px;">
                    ID: <%= p.id %>
                  </span>
                  <span class="history-time-served">Age: <%= p.age %> yrs</span>
                </div>
              </li>
            <% }) %>
          <% } %>
        </ul>
      </div>
    </main>
  </div>

  <!-- Theme switching script -->
  <script>
    const toggleInput = document.getElementById('theme-toggle-input');
    const themeLabel = document.getElementById('theme-label');
    const htmlElement = document.documentElement;

    // Load saved preference
    const savedTheme = localStorage.getItem('theme') || 'light';
    htmlElement.setAttribute('data-theme', savedTheme);
    toggleInput.checked = (savedTheme === 'dark');
    themeLabel.textContent = savedTheme === 'dark' ? 'Dark Mode' : 'Light Mode';

    // Switch handler
    toggleInput.addEventListener('change', () => {
      if (toggleInput.checked) {
        htmlElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        themeLabel.textContent = 'Dark Mode';
      } else {
        htmlElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
        themeLabel.textContent = 'Light Mode';
      }
    });

    // Generate random elegant soft colors for avatars to make contact-list pop
    const colors = [
      'rgba(3, 100, 255, 0.12)', // blue
      'rgba(255, 59, 48, 0.12)',  // red
      'rgba(255, 159, 10, 0.12)', // orange
      'rgba(48, 176, 199, 0.12)', // teal
      'rgba(52, 199, 89, 0.12)',  // green
      'rgba(175, 82, 222, 0.12)'  // purple
    ];
    const textColors = [
      'var(--color-primary)',
      'var(--color-high)',
      'var(--color-medium)',
      'var(--color-low)',
      '#34c759',
      '#af52de'
    ];

    document.querySelectorAll('.history-avatar').forEach((el, index) => {
      const colorIdx = index % colors.length;
      el.style.backgroundColor = colors[colorIdx];
      el.style.color = textColors[colorIdx];
    });
  </script>
</body>
</html>
